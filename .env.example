# ==============================================================================
# Grafik Motoru — Ortam Değişkenleri Yapılandırması
# ==============================================================================

# 1. GEMINI_API_KEY (Zorunlu — AI Özellikleri için):
# Google AI Studio üzerinden aldığınız geçerli API anahtarını buraya girin:
# https://aistudio.google.com/app/apikey (AIzaSy... ile başlar)
GEMINI_API_KEY=""

# 2. GEMINI_MODEL (İsteğe bağlı):
# Varsayılan model 'gemini-3.6-flash' olarak ayarlanmıştır.
GEMINI_MODEL="gemini-3.6-flash"

# 3. DOWNLOADER_SERVICE_URL (Vercel Deploy için Önerilir):
# Vercel serverless ortamında YouTube indirme işlemi yapabilmek için 'downloader-service/'
# klasörünü ayrı bir platformda (Railway, Render, Fly.io, Cloud Run vb.) deploy edip
# adresini buraya ekleyin:
DOWNLOADER_SERVICE_URL=""

# 4. DEBUG & LOGGING:
# Detaylı rota yönlendirme ve model istek loglarını görmek için 'true' yapabilirsiniz:
DEBUG=false

# İsteğe bağlı alternatif model; boşsa GEMINI_MODEL kullanılır.
GEMINI_FALLBACK_MODEL=""

# Yerel sunucu (varsayılan 3000):
PORT=3000

# Medya araçları için isteğe bağlı çalıştırılabilir dosya yolları:
# YT_DLP_PATH=/path/to/yt-dlp
# FFMPEG_PATH=/path/to/ffmpeg
