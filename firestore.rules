rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      // Firestore document IDs may contain Unicode and spaces; only a slash is
      // disallowed because it changes the document path.
      return id is string && id.size() > 0 && id.size() <= 128 && !id.matches('.*/.*');
    }

    // Secure owner authorization: requires a valid authenticated user (Google Auth or Anonymous Auth)
    function isAuthorizedOwner(userId) {
      return request.auth != null && userId == request.auth.uid;
    }

    // Template validation blueprint
    function isValidTemplate(data) {
      return data.keys().hasAll([
        'id', 'name', 'width', 'height', 'backgroundColor', 
        'primaryColor', 'accentColor', 'textColor', 'regions', 
        'fixedElements', 'userId'
      ]) &&
      data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
      data.name is string && data.name.size() > 0 && data.name.size() <= 256 &&
      data.width is int && data.width >= 100 && data.width <= 4096 &&
      data.height is int && data.height >= 100 && data.height <= 4096 &&
      data.backgroundColor is string && data.backgroundColor.size() <= 64 &&
      data.primaryColor is string && data.primaryColor.size() <= 64 &&
      data.accentColor is string && data.accentColor.size() <= 64 &&
      data.textColor is string && data.textColor.size() <= 64 &&
      data.regions is list && data.regions.size() <= 50 &&
      data.fixedElements is list && data.fixedElements.size() <= 50 &&
      data.userId is string && isAuthorizedOwner(data.userId);
    }

    function isValidProject(data, userId) {
      return data.keys().hasAll([
        'userId', 'currentTemplateId', 'graphicData', 'generatedPages',
        'templates', 'pagesByTemplate', 'syncVersion', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'currentTemplateId', 'graphicData', 'generatedPages',
        'templates', 'pagesByTemplate', 'syncVersion', 'updatedAt'
      ]) &&
      data.userId == userId &&
      isAuthorizedOwner(userId) &&
      isValidId(data.currentTemplateId) &&
      data.graphicData is map &&
      data.generatedPages is list && data.generatedPages.size() <= 250 &&
      data.templates is list && data.templates.size() <= 100 &&
      data.pagesByTemplate is map &&
      data.syncVersion == 1 &&
      data.updatedAt is timestamp;
    }

    match /templates/{templateId} {
      // Only authenticated owner can list, get, update, or delete their templates
      allow list, get: if request.auth != null && resource.data.userId == request.auth.uid;
                     
      allow create: if isValidId(templateId) && isValidTemplate(request.resource.data);
      
      allow update: if isValidId(templateId) && 
                       request.auth != null && 
                       resource.data.userId == request.auth.uid && 
                       isValidTemplate(request.resource.data);
                       
      allow delete: if isValidId(templateId) && 
                       request.auth != null && 
                       resource.data.userId == request.auth.uid;
    }

    match /graphic_projects/{userId} {
      allow get: if isAuthorizedOwner(userId);
      allow create, update: if isValidProject(request.resource.data, userId);
      allow delete: if isAuthorizedOwner(userId);
    }

    // Cross-account template sharing. A share is an immutable snapshot addressed by an
    // unguessable 8-character code: readable one-by-one (never listable) by any signed-in
    // user, creatable by an authenticated user for themselves, and revocable only by its owner.
    function isValidShareCode(code) {
      return code is string && code.size() == 8;
    }

    match /shared_templates/{code} {
      // Oturum açmış herhangi bir kullanıcı (Google veya Misafir), geçerli 8 haneli kod ile şablonu alabilir
      allow get: if isSignedIn() && isValidShareCode(code);
      
      // Oturum açmış kullanıcılar kendi UID'leri ile paylaşım kaydı oluşturabilir
      allow create: if isSignedIn() &&
                       isValidShareCode(code) &&
                       request.resource.data.code == code &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.templateJson is string &&
                       request.resource.data.templateJson.size() <= 1000000;
                       
      // Paylaşımlar anlık görüntüdür, doğrudan düzenlenemez
      allow update: if false;
      
      // Yalnızca paylaşımı oluşturan kullanıcı silebilir / geri çekebilir
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
